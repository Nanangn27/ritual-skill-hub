generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Skill {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  repository    String?
  documentation String?
  ownerAddress  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
